# CS Tennis — variáveis de ambiente (NUNCA commite valores reais).
# Todas são lidas apenas no servidor; nenhuma usa o prefixo NEXT_PUBLIC_.

# Projeto Supabase (Dashboard > Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta/service role: somente no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (HTTPS em produção). Também configure em
# Supabase > Authentication > URL Configuration (Site URL e Redirect URLs).
APP_URL=https://cstennis.example.com
# development | staging | production
APP_ENV=production

# Segredo para HMAC das chaves de rate limit (32+ caracteres aleatórios).
RATE_LIMIT_SECRET=
# Segredo para o endpoint de jobs de redundância (/api/jobs/*).
CRON_SECRET=

# Verificação antimalware de comprovantes: clamav | none
# Com "none", comprovantes ficam em quarentena e NÃO podem ser abertos.
FILE_SCAN_PROVIDER=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310

# Opcional: logotipo oficial (arquivo em public/brand/)
# BRAND_LOGO_SRC=/brand/logo.svg
